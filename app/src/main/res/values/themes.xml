    <style name="Theme.SlayTheAmethyst.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="alertDialogTheme">@style/ThemeOverlay.Launcher.AlertDialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.Launcher.Dialog</item>
    </style>
