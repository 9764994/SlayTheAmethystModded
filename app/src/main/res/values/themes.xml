        <item name="alertDialogTheme">@style/ThemeOverlay.Launcher.AlertDialog</item>
        <item name="android:windowBackground">@color/launcher_startup_background</item>
    </style>
    <style name="Theme.SlayTheAmethyst.Game" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/ThemeOverlay.Launcher.AlertDialog</item>
