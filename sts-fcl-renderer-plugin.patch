diff --git a/app/src/test/java/io/stamethyst/plugin/RendererPluginResolutionTest.kt b/app/src/test/java/io/stamethyst/plugin/RendererPluginResolutionTest.kt
new file mode 100644
index 0000000..29295dd
--- /dev/null
+++ b/app/src/test/java/io/stamethyst/plugin/RendererPluginResolutionTest.kt
@@ -0,0 +1,133 @@
+package io.stamethyst.plugin
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * 插件渲染器 v1/v2 环境与库路径解析的纯逻辑测试（不依赖 Android 运行时）。
+ * 覆盖 FCL 兼容协议的生效语义：DLOPEN 抽取、`**|` 库路径、可配置项默认值、目录拼接。
+ */
+class RendererPluginResolutionTest {
+
+    @get:Rule
+    val tempFolder = TemporaryFolder()
+
+    @Test
+    fun v1_pojavEnv_dlopenEntriesGoToDlopenListAndValuesToEnv() {
+        val dir = tempFolder.root.absolutePath
+        File(dir, "libspirv-cross-c-shared.so").createNewFile()
+        File(dir, "libzink_dri.so").createNewFile()
+
+        val result = RendererPlugin.resolveV1Env(
+            pojavEnv = "LIBGL_ES=2:LIBGL_MIPMAP=3:DLOPEN=libspirv-cross-c-shared.so,libzink_dri.so",
+            nativeDir = dir
+        )
+
+        assertEquals(mapOf("LIBGL_ES" to "2", "LIBGL_MIPMAP" to "3"), result.env)
+        assertEquals(
+            listOf(
+                "$dir/libspirv-cross-c-shared.so",
+                "$dir/libzink_dri.so"
+            ),
+            result.dlopen
+        )
+    }
+
+    @Test
+    fun v1_mesaLibraryKeyJoinsPluginDir() {
+        val dir = tempFolder.root.absolutePath
+        val result = RendererPlugin.resolveV1Env("LIB_MESA_NAME=libgallium_dri.so", nativeDir = dir)
+
+        // 与 FCL 一致：LIB_MESA_NAME 属于 joinsDirKeys，保留库名，运行时经 LD_LIBRARY_PATH（含插件目录）解析。
+        assertEquals("libgallium_dri.so", result.env["LIB_MESA_NAME"])
+    }
+
+    @Test
+    fun v2_selectableUsesDefaultValueAndDisabledCheckSkipsIt() {
+        val dir = tempFolder.root.absolutePath
+        val config = RendererConfigV2(
+            displayName = "test",
+            rendererId = "opengles2",
+            rendererGLPath = "/libgl.so",
+            rendererEGLPath = "libEGL.so",
+            env = listOf(
+                SelectableEnvV2(key = "LIBGL_ES", items = EnvItemsV2(defaultValue = "2", values = listOf("3"))),
+                SelectableEnvV2(key = "SKIPPED", check = false, items = EnvItemsV2(defaultValue = "x")),
+            )
+        )
+
+        val result = RendererPlugin.resolveV2Env(config, dir)
+
+        assertEquals("2", result.env["LIBGL_ES"])
+        assertTrue("SKIPPED" !in result.env)
+    }
+
+    @Test
+    fun v2_toggleableAndCustomizableUseTheirDefaults() {
+        val dir = tempFolder.root.absolutePath
+        val config = RendererConfigV2(
+            displayName = "test",
+            rendererId = "",
+            rendererGLPath = "libgl.so",
+            rendererEGLPath = "libEGL.so",
+            env = listOf(
+                ToggleableEnvV2(key = "LIBGL_USE_MC_COLOR", value = "1", toggle = true),
+                ToggleableEnvV2(key = "TURNED_OFF", value = "1", toggle = false),
+                CustomizableEnvV2(key = "MESA_GL_VERSION_OVERRIDE", defaultValue = "4.6"),
+                CustomizableEnvV2(key = "EMPTY", defaultValue = ""),
+            )
+        )
+
+        val result = RendererPlugin.resolveV2Env(config, dir)
+
+        assertEquals("1", result.env["LIBGL_USE_MC_COLOR"])
+        assertEquals("4.6", result.env["MESA_GL_VERSION_OVERRIDE"])
+        assertTrue("TURNED_OFF" !in result.env)
+        assertTrue("EMPTY" !in result.env)
+    }
+
+    @Test
+    fun v2_nativePrefixAndDlopenLibPathsResolveAgainstPluginDir() {
+        val dir = tempFolder.root.absolutePath
+        File(dir, "libcustom_gl.so").createNewFile()
+        File(dir, "libextra.so").createNewFile()
+        File(dir, "libfixed.so").createNewFile()
+        val config = RendererConfigV2(
+            displayName = "test",
+            rendererId = "",
+            rendererGLPath = "**|libcustom_gl.so",
+            rendererEGLPath = "**|libcustom_egl.so",
+            dlopenLibPaths = listOf("libfixed.so", "**|libcustom_gl.so"),
+            env = listOf(
+                NormalEnvV2(key = "DLOPEN", value = "**|libextra.so,libfixed.so"),
+                NormalEnvV2(key = "LIB_MESA_NAME", value = "**|libgallium_dri.so"),
+            )
+        )
+
+        val result = RendererPlugin.resolveV2Env(config, dir)
+
+        assertEquals("$dir/libgallium_dri.so", result.env["LIB_MESA_NAME"])
+        assertEquals(
+            listOf(
+                "$dir/libextra.so",
+                "$dir/libfixed.so",
+                "$dir/libcustom_gl.so"
+            ),
+            result.dlopen
+        )
+    }
+
+    @Test
+    fun joinPluginDir_absolutePrefixAndNativePrefixAreHandled() {
+        val dir = tempFolder.root.absolutePath
+        File(dir, "libexisting.so").createNewFile()
+
+        assertEquals("$dir/libexisting.so", RendererPlugin.joinPluginDir(dir, "libexisting.so"))
+        assertEquals("$dir/other.so", RendererPlugin.joinPluginDir(dir, "/other.so"))
+        assertEquals("$dir/libprefix.so", RendererPlugin.joinPluginDir(dir, "**|libprefix.so"))
+    }
+}
