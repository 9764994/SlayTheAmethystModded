@@ -0,0 +1,76 @@
+package io.stamethyst.plugin
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+
+/**
+ * 已安装渲染器插件的扫描器，兼容 FCL 渲染器插件 v1/v2 的 meta-data 声明协议：
+ *
+ * - v1：`renderer`（`名称:GL库:EGL库`）、`des`、`boatEnv`、`pojavEnv`；
+ * - v2：`fclPlugin_V2` 指向插件 APK 内 JSON 配置字符串资源。
+ *
+ * 扫描范围：安装了 launcher activity 的非系统应用（Android 11+ 需要
+ * manifest `<queries>` 中的 ACTION_MAIN 声明才能可见）。结果按应用名排序并缓存，
+ * 安装/卸载插件后调用 [invalidate] 失效重扫。
+ */
+object PluginManager {
+
+    const val META_PLUGIN = "fclPlugin"
+    const val META_PLUGIN_V2 = "fclPlugin_V2"
+
+    data class PluginApp(
+        val packageName: String,
+        val label: String,
+        val appInfo: ApplicationInfo,
+    )
+
+    private const val SCAN_FLAGS = PackageManager.GET_META_DATA
+
+    @Volatile
+    private var cache: List<PluginApp>? = null
+
+    fun invalidate() {
+        cache = null
+    }
+
+    fun scan(context: Context): List<PluginApp> {
+        cache?.let { return it }
+        val result = scanUncached(context)
+        cache = result
+        return result
+    }
+
+    private fun scanUncached(context: Context): List<PluginApp> {
+        val pm = context.packageManager
+        val apps = mutableListOf<PluginApp>()
+        val resolvedActivities = pm.queryIntentActivities(
+            Intent(Intent.ACTION_MAIN),
+            SCAN_FLAGS
+        )
+        for (resolved in resolvedActivities) {
+            val info = resolved.activityInfo?.applicationInfo ?: continue
+            if (info.flags and ApplicationInfo.FLAG_SYSTEM != 0) {
+                continue
+            }
+            val metaData = info.metaData ?: continue
+            // 与 FCL 的两步判定一致：先看是否声明为插件（fclPlugin=true 或 v2 JSON），
+            // 再看是否渲染器类型（v1 renderer 字符串或 v2 JSON）。
+            val isPlugin = metaData.getBoolean(META_PLUGIN, false) ||
+                metaData.containsKey(META_PLUGIN_V2)
+            if (!isPlugin) {
+                continue
+            }
+            val isRendererPlugin = metaData.getString("renderer") != null ||
+                metaData.containsKey(META_PLUGIN_V2)
+            if (!isRendererPlugin) {
+                continue
+            }
+            val label = runCatching { info.loadLabel(pm).toString() }
+                .getOrDefault(info.packageName)
+            apps += PluginApp(info.packageName, label, info)
+        }
+        return apps.sortedBy { it.label.lowercase() }
+    }
+}
diff --git a/app/src/main/java/io/stamethyst/plugin/PluginRenderer.kt b/app/src/main/java/io/stamethyst/plugin/PluginRenderer.kt
