@@ -0,0 +1,50 @@
+package io.stamethyst.backend.render
+
+import io.stamethyst.config.RenderSurfaceBackend
+
+/**
+ * 游戏进程可用的渲染后端统一抽象。
+ *
+ * 内置后端是编译期固定的 [RendererBackend] 枚举；插件后端由已安装 APK 的
+ * meta-data 声明动态构造（见 `io.stamethyst.plugin`，兼容 FCL 渲染器插件协议），
+ * 两者在设置、决策与启动注入链路中以同一接口流通。
+ */
+interface RenderBackend {
+
+    /** 稳定标识，持久化到偏好中的字符串；插件后端使用 `plugin:` 前缀避免与内置 id 冲突。 */
+    fun rendererId(): String
+
+    /** 设置页展示名。 */
+    val displayName: String
+
+    /** LWJGL/EGL 桥接层要 dlopen 的入口 GL 库（如 `libmobileglues.so`）。 */
+    fun lwjglOpenGlLibName(): String
+
+    /** EGL 库名（POJAVEXEC_EGL 注入用）；内置后端为 null，由各内置分支自行设置。 */
+    fun eglLibName(): String? = null
+
+    /** 可用性判定所需的原生库名；插件后端指插件 nativeLibraryDir 内的库。 */
+    val requiredNativeLibraries: Set<String>
+
+    /** 该后端是否需要设备支持 Vulkan。 */
+    val requiresVulkan: Boolean
+
+    /** 强制使用的表面后端（如 Kopper Zink 强制 TextureView）。 */
+    val forcedSurfaceBackend: RenderSurfaceBackend?
+
+    /** 启动时额外注入的环境变量。`DLOPEN` 键不放入环境，而是进入 [dlopenLibraries]。 */
+    val envVars: Map<String, String>
+
+    /** 启动前需额外 dlopen 的库（绝对路径或可经 LD_LIBRARY_PATH 解析的库名）。 */
+    val dlopenLibraries: List<String>
+
+    /** 追加到 LD_LIBRARY_PATH 的目录（如插件 nativeLibraryDir）。 */
+    val libraryDirectories: List<String>
+
+    /** 是否支持 Swappy 帧节奏；插件后端保守禁用（Swappy 仅对系统 EGL 路径可靠）。 */
+    val supportsSwappyFramePacing: Boolean
+
+    /** 是否为安装的插件提供的动态后端。 */
+    val isPlugin: Boolean
+        get() = false
+}
