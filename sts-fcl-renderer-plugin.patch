+@file:OptIn(kotlinx.serialization.InternalSerializationApi::class)
+
+package io.stamethyst.plugin
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+/**
+ * FCL 渲染器插件 v2 的 JSON 配置契约（对应 ZalithLauncher/RendererPlugin-v2 的 DSL 序列化结果）。
+ * 插件 APK 以 `fclPlugin_V2` meta-data 声明一个字符串资源 id，资源内容是下面的 JSON。
+ *
+ * 只描述公开格式本身，不含任何 FCL 实现代码；解析与生效逻辑见 [RendererPlugin]。
+ */
+@Serializable
+data class RendererConfigV2(
+    @SerialName("displayName")
+    val displayName: String,
+    @SerialName("rendererId")
+    val rendererId: String,
+    @SerialName("rendererGLPath")
+    val rendererGLPath: String,
+    @SerialName("rendererEGLPath")
+    val rendererEGLPath: String,
+    @SerialName("dlopenLibPaths")
+    val dlopenLibPaths: List<String> = emptyList(),
+    @SerialName("env")
+    val env: List<EnvV2> = emptyList(),
+    @SerialName("minMCVer")
+    val minMCVer: String? = null,
+    @SerialName("maxMCVer")
+    val maxMCVer: String? = null,
+)
+
+/** 环境变量项；JSON 中以 `type` 判别子区分具体类型。 */
+@Serializable
+sealed interface EnvV2
+
+/** 固定环境变量，不可配置。 */
+@Serializable
+@SerialName("NormalEnv")
+data class NormalEnvV2(
+    @SerialName("key")
+    val key: String,
+    @SerialName("value")
+    val value: String,
+) : EnvV2
+
+/** 预设候选中取值的环境变量；check 为 null/false 表示默认不启用。 */
+@Serializable
+@SerialName("SelectableEnv")
+data class SelectableEnvV2(
+    @SerialName("key")
+    val key: String,
+    @SerialName("title")
+    val title: MetaStringV2? = null,
+    @SerialName("check")
+    val check: Boolean? = true,
+    @SerialName("items")
+    val items: EnvItemsV2,
+) : EnvV2
+
+/** 用户自由输入值的环境变量；值为空则不启用。未做配置 UI 时按 defaultValue 生效。 */
+@Serializable
+@SerialName("CustomizableEnv")
+data class CustomizableEnvV2(
+    @SerialName("key")
+    val key: String,
+    @SerialName("title")
+    val title: MetaStringV2? = null,
+    @SerialName("defaultValue")
+    val defaultValue: String? = null,
+) : EnvV2
+
+/** 开关式环境变量；toggle 决定默认是否启用。 */
+@Serializable
+@SerialName("ToggleableEnv")
+data class ToggleableEnvV2(
+    @SerialName("key")
+    val key: String,
+    @SerialName("value")
+    val value: String,
+    @SerialName("title")
+    val title: MetaStringV2? = null,
+    @SerialName("toggle")
+    val toggle: Boolean = true,
+) : EnvV2
+
+/** Selectable 候选项；defaultValue 视为列表中的一项。 */
+@Serializable
+data class EnvItemsV2(
+    @SerialName("defaultValue")
+    val defaultValue: String,
+    @SerialName("values")
+    val values: List<String> = emptyList(),
+)
+
+/** 标题资源索引；启动器通过插件 meta-data 中同名项的资源 id 读取本地化文本。 */
+@Serializable
+data class MetaStringV2(
+    @SerialName("key")
+    val key: String,
+)
+
+/** v2 JSON 容忍未知字段（与官方 DSL 解析行为一致）。 */
+val rendererV2Json = kotlinx.serialization.json.Json {
+    ignoreUnknownKeys = true
+}
diff --git a/app/src/main/java/io/stamethyst/plugin/RendererPlugin.kt b/app/src/main/java/io/stamethyst/plugin/RendererPlugin.kt
new file mode 100644
index 0000000..8d3f811
--- /dev/null
+++ b/app/src/main/java/io/stamethyst/plugin/RendererPlugin.kt
@@ -0,0 +1,263 @@
+package io.stamethyst.plugin
+
+import android.content.Context
+import android.os.Bundle
+import android.util.Log
+import io.stamethyst.config.RenderSurfaceBackend
+import kotlinx.serialization.decodeFromString
+import java.io.File
+
+/**
+ * FCL 兼容渲染器插件解析器：把已安装插件 APK 的 meta-data 声明解析成 [PluginRenderer]。
+ *
+ * - v1：`renderer`（`名称:GL库:EGL库`）+ `des` + `pojavEnv`（`K=V:K=V` 冒号分隔）；
+ * - v2：`fclPlugin_V2` 指向 JSON 字符串资源（见 [RendererConfigV2]），v2 优先于 v1。
+ *
+ * 解析结果按包名缓存，插件安装/卸载后调用 [invalidate] 重扫。协议行为与 FCL 启动链路
+ * 对齐（DLOPEN 列表、`**|` 插件库路径、LIB_MESA_NAME/MESA_LIBRARY 目录拼接），
+ * 但实现独立，不包含 FCL 代码。
+ */
+object RendererPlugin {
+
+    private const val TAG = "STS-RendererPlugin"
+
+    /** v2 路径前缀：`**|lib.so` 表示相对插件 nativeLibraryDir 的库路径。 */
+    private const val NATIVE_PREFIX = "**|"
+
+    /** 这些 key 的值是库文件名，最终会拼上插件目录（与 FCL 启动链路一致）。 */
+    private val joinsDirKeys = setOf("LIB_MESA_NAME", "MESA_LIBRARY", "DLOPEN")
+
+    @Volatile
+    private var cache: List<PluginRenderer>? = null
+
+    fun invalidate() {
+        cache = null
+    }
+
+    fun renderers(context: Context): List<PluginRenderer> {
+        cache?.let { return it }
+        val list = buildList {
+            for (app in PluginManager.scan(context)) {
+                parse(app, context)?.let { add(it) }
+            }
+        }
+        cache = list
+        return list
+    }
+
+    private fun parse(app: PluginManager.PluginApp, context: Context): PluginRenderer? {
+        val metaData = app.appInfo.metaData ?: return null
+        if (metaData.containsKey(PluginManager.META_PLUGIN_V2)) {
+            return parseV2(app, metaData, context)
+        }
+        return parseV1(app, metaData)
+    }
+
+    // ---- v1 -----------------------------------------------------------------------------------
+
+    private fun parseV1(app: PluginManager.PluginApp, metaData: Bundle): PluginRenderer? {
+        val rendererSpec = metaData.getString("renderer") ?: return null
+        val description = metaData.getString("des") ?: return null
+        val pojavEnv = metaData.getString("pojavEnv") ?: ""
+        val parts = rendererSpec.split(":")
+        if (parts.size < 3) {
+            Log.w(TAG, "v1 renderer spec malformed for ${app.packageName}: $rendererSpec")
+            return null
+        }
+        val nativeDir = app.appInfo.nativeLibraryDir
+        val glName = parts[1]
+        val eglName = parts[2]
+        val envResolution = resolveV1Env(pojavEnv, nativeDir)
+        val glLib = joinPluginDir(nativeDir, glName)
+        val eglLib = joinPluginDir(nativeDir, eglName)
+        return PluginRenderer(
+            id = "plugin:" + app.packageName,
+            displayName = description,
+            glLibName = glLib,
+            eglLibNameValue = eglLib,
+            requiredNativeLibraries = setOf(glName.substringAfterLast('/'), eglName.substringAfterLast('/')),
+            requiresVulkan = false,
+            forcedSurfaceBackend = null,
+            envVars = envResolution.env,
+            dlopenLibraries = buildList {
+                add(glLib)
+                addAll(envResolution.dlopen)
+            }.distinct(),
+            libraryDirectories = listOf(nativeDir),
+            packageName = app.packageName,
+            sourceLabel = app.label,
+        )
+    }
+
+    // ---- v2 -----------------------------------------------------------------------------------
+
+    private fun parseV2(app: PluginManager.PluginApp, metaData: Bundle, context: Context): PluginRenderer? {
+        val configResId = metaData.getInt(PluginManager.META_PLUGIN_V2)
+        if (configResId == 0) {
+            return null
+        }
+        val config = runCatching {
+            val resources = context.packageManager.getResourcesForApplication(app.appInfo)
+            val configJson = resources.getString(configResId) ?: return null
+            rendererV2Json.decodeFromString<RendererConfigV2>(configJson)
+        }.getOrElse { error ->
+            Log.w(TAG, "v2 renderer config unreadable for ${app.packageName}", error)
+            return null
+        }
+        val nativeDir = app.appInfo.nativeLibraryDir
+        val resolution = resolveV2Env(config, nativeDir)
+        val glLib = joinPluginDir(nativeDir, config.rendererGLPath)
+        val eglLib = joinPluginDir(nativeDir, config.rendererEGLPath)
+        val isZinkFamily = config.rendererId == "opengles3_desktopgl_zink_kopper" ||
+            resolution.env["MESA_LOADER_DRIVER_OVERRIDE"]?.equals("zink", ignoreCase = true) == true
+        val envVars = LinkedHashMap(resolution.env)
+        if (config.rendererId.isNotBlank() && !envVars.containsKey("POJAV_RENDERER")) {
+            envVars["POJAV_RENDERER"] = config.rendererId
+        }
+        return PluginRenderer(
+            id = "plugin:" + app.packageName,
+            displayName = config.displayName,
+            glLibName = glLib,
+            eglLibNameValue = eglLib,
+            requiredNativeLibraries = setOf(
+                config.rendererGLPath.substringAfterLast('/'),
+                config.rendererEGLPath.substringAfterLast('/'),
+            ),
+            requiresVulkan = isZinkFamily,
+            forcedSurfaceBackend = if (isZinkFamily) RenderSurfaceBackend.TEXTURE_VIEW else null,
+            envVars = envVars,
+            dlopenLibraries = buildList {
+                add(glLib)
+                addAll(resolution.dlopen)
+            }.distinct(),
+            libraryDirectories = listOf(nativeDir),
+            packageName = app.packageName,
+            sourceLabel = app.label,
+        )
+    }
+
+    // ---- 纯解析逻辑（无 Android 依赖，便于单元测试） -------------------------------------------
+
+    internal data class EnvResolution(
+        val env: Map<String, String>,
+        val dlopen: List<String>,
+    )
+
+    /**
+     * v1 `pojavEnv`（`K=V:K=V`）解析：`DLOPEN=liba.so,libb.so` 进入 dlopen 列表，
+     * 其余进入环境变量；`LIB_MESA_NAME`/`MESA_LIBRARY` 拼上插件目录。
+     */
+    internal fun resolveV1Env(pojavEnv: String, nativeDir: String): EnvResolution {
+        val env = LinkedHashMap<String, String>()
+        val dlopen = mutableListOf<String>()
+        pojavEnv.split(":").forEach { entry ->
+            if (entry.isBlank()) {
+                return@forEach
+            }
+            val separator = entry.indexOf('=')
+            if (separator <= 0) {
+                return@forEach
+            }
+            val key = entry.substring(0, separator)
+            val value = entry.substring(separator + 1)
+            if (key == "DLOPEN") {
+                dlopen += splitLibList(value).map { joinPluginDir(nativeDir, it) }
+            } else {
+                env[key] = resolveV1Value(key, value, nativeDir)
+            }
+        }
+        return EnvResolution(env, dlopen.distinct())
+    }
+
+    /** v2 JSON 环境解析：可配置项按默认值生效（Selectable 取 defaultValue，Toggleable 看 toggle）。 */
+    internal fun resolveV2Env(config: RendererConfigV2, nativeDir: String): EnvResolution {
+        val env = LinkedHashMap<String, String>()
+        val dlopen = mutableListOf<String>()
+        fun collectDlopen(raw: String) {
+            // DLOPEN 是逗号分隔的库列表：先按项拆分，再逐项做插件目录归一化。
+            dlopen += splitLibList(raw).map { joinPluginDir(nativeDir, it) }
+        }
+        for (item in config.env) {
+            when (item) {
+                is NormalEnvV2 -> {
+                    if (item.key == "DLOPEN") {
+                        collectDlopen(item.value)
+                    } else {
+                        env[item.key] = resolveV2Value(item.key, item.value, nativeDir)
+                    }
+                }
+
+                is SelectableEnvV2 -> {
+                    if (item.check != false) {
+                        item.items.defaultValue.takeIf { it.isNotEmpty() }
+                            ?.let { env[item.key] = it }
+                    }
+                }
+
+                is CustomizableEnvV2 -> {
+                    item.defaultValue?.takeIf { it.isNotEmpty() }?.let { env[item.key] = it }
+                }
+
+                is ToggleableEnvV2 -> {
+                    if (item.toggle) {
+                        env[item.key] = resolveV2Value(item.key, item.value, nativeDir)
+                    }
+                }
+            }
+        }
+        for (raw in config.dlopenLibPaths) {
+            collectDlopen(raw)
+        }
+        return EnvResolution(env, dlopen.distinct())
+    }
+
+    private fun resolveV1Value(key: String, value: String, nativeDir: String): String {
+        // v1 启动链路会对 LIB_MESA_NAME/MESA_LIBRARY 无条件拼接插件目录，这里同样处理为绝对路径。
+        if (key == "LIB_MESA_NAME" || key == "MESA_LIBRARY") {
+            return if (value.startsWith("/")) {
+                if (value.startsWith(nativeDir)) value else nativeDir + value
+            } else {
+                "$nativeDir/$value"
+            }
+        }
+        return value
+    }
+
+    private fun resolveV2Value(key: String, raw: String, nativeDir: String): String {
+        val joinsDir = key in joinsDirKeys
+        if (raw.startsWith(NATIVE_PREFIX)) {
+            val lib = raw.removePrefix(NATIVE_PREFIX)
+            return if (joinsDir) lib else "$nativeDir/$lib"
+        }
+        if (joinsDir && raw.startsWith("/")) {
+            return raw.substringAfterLast('/')
+        }
+        return raw
+    }
+
+    /**
+     * 库路径归一化：`**|` 前缀是"进插件 nativeLibraryDir"的显式指示，无条件拼接；
+     * `/` 开头视为相对插件目录的路径（与 FCL v1 `V1_DIR_PREFIX` 语义一致）；
+     * 裸库名若在插件目录真实存在则拼目录，否则原样返回依赖 LD_LIBRARY_PATH 解析。
+     */
+    internal fun joinPluginDir(nativeDir: String, libName: String): String {
+        if (libName.isEmpty()) {
+            return libName
+        }
+        if (libName.startsWith(NATIVE_PREFIX)) {
+            val lib = libName.removePrefix(NATIVE_PREFIX)
+            return if (lib.startsWith("/")) {
+                if (lib.startsWith(nativeDir)) lib else nativeDir + lib
+            } else {
+                "$nativeDir/$lib"
+            }
+        }
+        if (libName.startsWith("/")) {
+            return if (libName.startsWith(nativeDir)) libName else nativeDir + libName
+        }
+        return if (File(nativeDir, libName).isFile()) "$nativeDir/$libName" else libName
+    }
+
+    private fun splitLibList(raw: String): List<String> =
+        raw.split(',').map { it.trim() }.filter { it.isNotEmpty() }
+}
