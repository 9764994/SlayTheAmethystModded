@@ -0,0 +1,44 @@
+package io.stamethyst.plugin
+
+import io.stamethyst.backend.render.RenderBackend
+import io.stamethyst.config.RenderSurfaceBackend
+
+/**
+ * 由已安装插件 APK 动态构造的渲染后端。
+ *
+ * 字段在 [RendererPlugin] 解析插件 meta-data（v1 字符串 / v2 JSON）时生成，
+ * 语义与 FCL 渲染器插件启动链路对齐：插件 nativeLibraryDir 会进入
+ * LD_LIBRARY_PATH，EGL 库作为 POJAVEXEC_EGL 注入，GL 库作为 LWJGL 的
+ * `org.lwjgl.opengl.libname`，声明环境变量原样应用，DLOPEN 列表在 JVM 初始化前逐一 dlopen。
+ */
+data class PluginRenderer(
+    private val id: String,
+    override val displayName: String,
+    /** GL 翻译库：绝对路径，或可经 LD_LIBRARY_PATH 解析的库名。 */
+    private val glLibName: String,
+    /** EGL 库：绝对路径，或可经 LD_LIBRARY_PATH 解析的库名。 */
+    private val eglLibNameValue: String,
+    override val requiredNativeLibraries: Set<String>,
+    override val requiresVulkan: Boolean,
+    override val forcedSurfaceBackend: RenderSurfaceBackend?,
+    override val envVars: Map<String, String>,
+    override val dlopenLibraries: List<String>,
+    override val libraryDirectories: List<String>,
+    /** 插件 APK 包名。 */
+    val packageName: String,
+    /** 插件应用名（列表来源显示）。 */
+    val sourceLabel: String,
+) : RenderBackend {
+
+    override fun rendererId(): String = id
+
+    override fun lwjglOpenGlLibName(): String = glLibName
+
+    override fun eglLibName(): String = eglLibNameValue
+
+    override val supportsSwappyFramePacing: Boolean
+        get() = false
+
+    override val isPlugin: Boolean
+        get() = true
+}
